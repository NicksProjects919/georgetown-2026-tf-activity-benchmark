process {
    executor       = 'slurm'
    queue          = 'shared'
    clusterOptions = '--account=gtw109 --nodes=1 --ntasks=1'
    resourceLimits = [
        cpus: 32,
        memory: 64.GB,
        time: 24.h
    ]
    errorStrategy  = 'retry'
    maxRetries     = 2
}

executor {
    queueSize       = 20
    submitRateLimit = '10/1min'
}

singularity {
    enabled    = true
    autoMounts = true
}
