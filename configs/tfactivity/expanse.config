process {
    executor       = 'slurm'
    queue          = 'shared'
    clusterOptions = '--account=gtw109'
    cpus           = 4
    memory         = 16.GB
    time           = 4.h
    errorStrategy  = 'retry'
    maxRetries     = 2
}
executor {
    queueSize       = 50
    submitRateLimit = '10/1min'
}
singularity {
    enabled    = true
    autoMounts = true
}
